# myCFCMS MCP server — copy to .env and fill in.
#
# `mcp/.env` is gitignored. The tokens below are live credentials: a token
# committed once stays in the history for ever.

# ---------------------------------------------------------------------------
# One block per site. The NAME in the middle is what you say in a prompt
# ("list the draft pages on willcreator"), compared case-insensitively and
# treating - and _ as the same character.
#
# A myCFCMS token is bound to the site it was issued for, so each site needs
# its own. Issue them at /admin/api-tokens as a user holding the Agent role.
# ---------------------------------------------------------------------------

CMS_SITE_WILLCREATOR_URL=https://willcreator.com.au
CMS_SITE_WILLCREATOR_TOKEN=cms_replace_me

CMS_SITE_CLEVERMINDS_URL=https://cleverminds.com.au
CMS_SITE_CLEVERMINDS_TOKEN=cms_replace_me

# ---------------------------------------------------------------------------
# Working locally
# ---------------------------------------------------------------------------
# The URL is the site's own origin, because tenancy is resolved from the Host
# header and Node's fetch refuses to let anything override it. So locally,
# point the domains at loopback in /etc/hosts and keep CommandBox's port:
#
#   127.0.0.1  willcreator.test  cleverminds.test
#
#   CMS_SITE_WILLCREATOR_URL=http://willcreator.test:58988
#
# and register those hostnames as domains on the sites. `box server info`
# reports the port.

# Which site read-only tools use when a call does not name one. Writes never
# default — they always require an explicit site. Optional, and unnecessary
# when only one site is configured.
# CMS_DEFAULT_SITE=willcreator

# Per-request HTTP timeout, milliseconds. Default 30000. A site-wide SEO audit
# is polled rather than waited on, so this does not need to cover a crawl.
# CMS_TIMEOUT_MS=30000

# upload_media refuses any path outside this directory, because an upload
# becomes publicly reachable and the CMS's extension allow-list would not stop
# a .txt or a .csv. Defaults to the server's working directory.
# CMS_UPLOAD_ROOT=/path/to/approved/assets
